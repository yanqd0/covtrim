{
  "name": "covtrim",
  "version": "0.2.0-alpha.1",
  "description": "Token-efficient coverage report compressor for LLM/agent consumption. Reads lcov, outputs compact TSV.",
  "type": "module",
  "bin": {
    "covtrim": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanqd0/covtrim.git"
  },
  "keywords": [
    "coverage",
    "lcov",
    "llm",
    "tsv",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dogfood": "pnpm test:coverage && tsx src/index.ts --tokens coverage/lcov.info",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
